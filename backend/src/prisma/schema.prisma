generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String         @id @default(cuid())
  email                  String         @unique
  password               String?
  name                   String
  kakaoId                String?        @unique
  studentId              String?
  role                   Role           @default(ATTENDEE)
  emailVerified          Boolean        @default(false)
  verifyToken            String?        @unique
  resetToken             String?        @unique
  resetTokenExpiry       DateTime?
  schoolId               String?
  createdAt              DateTime       @default(now())
  deletedAt              DateTime?
  verifyTokenExpiry      DateTime?
  hostedEvents           Event[]        @relation("EventHost")
  cancelledRegistrations Registration[] @relation("CancelledBy")
  registrations          Registration[] @relation("Registrant")
  auditLogs              AuditLog[]     @relation("AuditAdmin")
  school                 School?        @relation(fields: [schoolId], references: [id])

  @@unique([studentId, schoolId])
}

model School {
  id        String    @id @default(cuid())
  name      String    @unique
  domain    String    @unique
  address   String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  events    Event[]
  users     User[]
}

model Event {
  id                      String             @id @default(cuid())
  title                   String
  description             String?
  location                String?
  schoolId                String
  school                  School             @relation(fields: [schoolId], references: [id])
  hostId                  String
  host                    User               @relation("EventHost", fields: [hostId], references: [id])
  hostNameSnapshot        String?
  hostAffiliationSnapshot String?
  status                  EventStatus        @default(DRAFT)
  isPaid                  Boolean            @default(false)
  price                   Int?
  capacity                Int
  startAt                 DateTime
  endAt                   DateTime
  registrationDeadline    DateTime?
  imageUrl                String?
  publishAt               DateTime?
  closedAt                DateTime?
  releaseIntervalMinutes  Int?
  refundContact           String?
  refundDeadlineType      RefundDeadlineType @default(NONE)
  refundDeadlineValue     Int?
  refundDeadlineAt        DateTime?
  refundPolicyText        String?
  contactEmail            String?
  contactPhone            String?
  registrations           Registration[]
  whitelist               EventWhitelist?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  deletedAt               DateTime?
}

model EventWhitelist {
  id        String           @id @default(cuid())
  eventId   String           @unique
  event     Event            @relation(fields: [eventId], references: [id])
  entries   WhitelistEntry[]
  createdAt DateTime         @default(now())
}

model WhitelistEntry {
  id          String         @id @default(cuid())
  whitelistId String
  whitelist   EventWhitelist @relation(fields: [whitelistId], references: [id])
  studentId   String
  createdAt   DateTime       @default(now())

  @@unique([whitelistId, studentId])
}

model Registration {
  id              String             @id @default(cuid())
  eventId         String
  event           Event              @relation(fields: [eventId], references: [id])
  userId          String
  user            User               @relation("Registrant", fields: [userId], references: [id])
  status          RegistrationStatus @default(PENDING_PAYMENT)
  orderId         String?            @unique
  paymentKey      String?
  paidAmount      Int?
  paidAt          DateTime?
  refundedAmount  Int?
  refundedAt      DateTime?
  idempotencyKey  String?
  retryCount      Int                @default(0)
  nextRetryAt     DateTime?
  cancelReason    String?
  cancelledBy     String?
  cancelledByUser User?              @relation("CancelledBy", fields: [cancelledBy], references: [id])
  checkedInAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation("AuditAdmin", fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String
  detail     String?
  createdAt  DateTime @default(now())
}

enum Role {
  ATTENDEE     // 일반사용자
  CERTIFIED    // 인증사용자(주최자)
  SCHOOL_ADMIN // 학교총관리자
  OPERATOR     // 운영자
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

enum RefundDeadlineType {
  NONE
  MINUTES
  HOURS
}

enum RegistrationStatus {
  PENDING_PAYMENT
  CONFIRMED
  EXPIRED
  CANCELLATION_REQUESTED
  CANCELLED
  REFUND_FAILED
  CHECKED_IN
}
